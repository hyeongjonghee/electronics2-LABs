# LAB5-03 adc (교재 3.4절). clk: 교재 표의 N8은 오기로 보고 메인 클록 B6 사용
set_property PACKAGE_PIN B6 [get_ports clk_50mhz]
set_property PACKAGE_PIN K4 [get_ports rst_p]
set_property PACKAGE_PIN Y1 [get_ports {add_sel[2]}]
set_property PACKAGE_PIN W3 [get_ports {add_sel[1]}]
set_property PACKAGE_PIN U2 [get_ports {add_sel[0]}]
set_property PACKAGE_PIN H5 [get_ports adc_din]
set_property PACKAGE_PIN J6 [get_ports adc_dout]
set_property PACKAGE_PIN H3 [get_ports adc_ncs]
set_property PACKAGE_PIN H7 [get_ports adc_sclk]
set_property PACKAGE_PIN L4 [get_ports {led[7]}]
set_property PACKAGE_PIN M4 [get_ports {led[6]}]
set_property PACKAGE_PIN M2 [get_ports {led[5]}]
set_property PACKAGE_PIN N7 [get_ports {led[4]}]
set_property PACKAGE_PIN M7 [get_ports {led[3]}]
set_property PACKAGE_PIN M3 [get_ports {led[2]}]
set_property PACKAGE_PIN M1 [get_ports {led[1]}]
set_property PACKAGE_PIN N5 [get_ports {led[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports *]
create_clock -name clk_50mhz -period 20.000 [get_ports clk_50mhz]
set_false_path -from [get_ports {rst_p add_sel[*]}]
