## LAB1-01 AND/OR/XOR logic_gate - Spartan-7 (xc7s75fgga484-1)
set_property PACKAGE_PIN K4 [get_ports a]
set_property IOSTANDARD LVCMOS33 [get_ports a]

set_property PACKAGE_PIN N8 [get_ports b]
set_property IOSTANDARD LVCMOS33 [get_ports b]

set_property PACKAGE_PIN L4 [get_ports x]
set_property IOSTANDARD LVCMOS33 [get_ports x]

set_property PACKAGE_PIN M4 [get_ports y]
set_property IOSTANDARD LVCMOS33 [get_ports y]

set_property PACKAGE_PIN M2 [get_ports z]
set_property IOSTANDARD LVCMOS33 [get_ports z]
